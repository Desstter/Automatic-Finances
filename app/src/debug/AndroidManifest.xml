<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- DEBUG-ONLY: registers the test SMS-injection receiver. Merged only into debug builds, so the
         release APK never exposes it. See DebugTestSmsReceiver for the adb command to trigger it. -->
    <application>
        <receiver
            android:name=".system.DebugTestSmsReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.automaticfinances.debug.TEST_SMS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

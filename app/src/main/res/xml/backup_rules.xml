<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-backup rules for devices older than API 31 (fullBackupContent).

    allowBackup="false" already disables backup on all API levels, so these rules are belt-and-
    suspenders: even if backup were ever re-enabled, the unencrypted bank database is excluded.
-->
<full-backup-content>
    <exclude domain="database" path="autobook.db" />
    <exclude domain="database" path="autobook.db-wal" />
    <exclude domain="database" path="autobook.db-shm" />
</full-backup-content>
